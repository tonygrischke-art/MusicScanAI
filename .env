# MusicScan AI Environment Variables
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git

# Sentry Crash Reporting
# Get DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o123456.ingest.sentry.io/123456

# RevenueCat In-App Purchases
# Get API keys from https://app.revenuecat.com/apps
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_your_public_api_key

# Last.fm Integration
# Get API key from https://www.last.fm/api/account/create
EXPO_PUBLIC_LASTFM_API_KEY=your_lastfm_api_key
EXPO_PUBLIC_LASTFM_SECRET=your_lastfm_secret

# Gemini AI (for mood/genre analysis)
# Get API key from https://makersuite.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# AcoustID (optional - free tier available)
# Get API key from https://acoustid.org/api-key
EXPO_PUBLIC_ACOUSTID_API_KEY=your_acoustid_api_key

# Development/Testing
# Set to 'true' to enable debug logging
EXPO_PUBLIC_DEBUG_MODE=true