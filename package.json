{
  "name": "musicscanai",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "npx expo prebuild --platform android --no-install --clean && cd android && ./gradlew assembleDebug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "android:clean": "rm -rf android && npx expo prebuild --platform android --no-install",
    "postprebuild": "node scripts/patch-gradle.js"
  },
  "dependencies": {
    "@react-native-community/slider": "4.5.5",
    "@shopify/flash-list": "1.7.3",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/node": "^26.6.1",
    "chromaprint": "^0.1.0",
    "essentia.js": "^0.1.3",
    "expo": "~52.0.0",
    "expo-blur": "~14.0.3",
    "expo-build-properties": "~0.13.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.2",
    "expo-haptics": "~14.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-media-library": "~17.0.0",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-sensors": "~14.0.2",
    "expo-speech": "~13.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.6",
    "lastfm-node-client": "^1.1.0",
    "liricle": "^3.0.0",
    "lrc-file-parser": "^0.1.3",
    "music-metadata": "^11.15.0",
    "node-acoustid": "^0.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-lrc": "^2.1.4",
    "react-native": "0.76.9",
    "react-native-blurhash": "^2.0.2",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-mmkv": "2.12.2",
    "react-native-purchases": "^10.10.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-track-player": "^4.1.1",
    "react-native-web": "~0.19.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.0.0",
    "@types/react": "~18.3.0",
    "babel-jest": "^29.0.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.0.0",
    "typescript": "~5.3.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      }
    }
  },
  "private": true
}
